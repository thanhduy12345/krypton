+
+    private int withChannel(final int rgb, final int channel, final int value) {
+        int r = (rgb >> 16) & 255;
+        int g = (rgb >> 8) & 255;
+        int b = rgb & 255;
+        if (channel == 0) {
+            r = value;
+        } else if (channel == 1) {
+            g = value;
+        } else {
+            b = value;
+        }
+        return (r << 16) | (g << 8) | b;
+    }
+
+    private void drawHex(final DrawContext ctx) {
+        PickerUi.text(ctx, "HEX COLOR", AREA_X + 4, HEX_Y + 10, PickerUi.TEXT.getRGB(), 0.7f);
+        final String shown = this.hexFocused ? this.hexText : String.format("%06X", this.currentRgb());
+        final boolean valid = validHex(shown);
+        PickerUi.rounded(ctx, new Color(18, 19, 22, 255), HEX_FIELD_X, HEX_Y, HEX_FIELD_X + HEX_FIELD_W, HEX_Y + HEX_H, 9);
+        final Color border;
+        if (this.hexFocused) {
+            border = valid ? PickerUi.ACCENT : PickerUi.DANGER;
+        } else {
+            border = new Color(70, 72, 80, 255);
+        }
+        PickerUi.outline(ctx, border, HEX_FIELD_X, HEX_Y, HEX_FIELD_X + HEX_FIELD_W, HEX_Y + HEX_H, 9, 1.5);
+        final String caret = this.hexFocused && System.currentTimeMillis() % 1000L < 500L ? "|" : "";
+        PickerUi.text(ctx, "#" + shown + caret, HEX_FIELD_X + 12, HEX_Y + 9, PickerUi.TEXT.getRGB(), 0.75f);
+    }
