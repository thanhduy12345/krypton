+ * Mỗi khung hình, sự kiện END_MAIN của Fabric gọi Render3DEvent cho các module,
+ * các module vẽ qua RenderUtils.renderFilledBox / renderLine, sau đó mọi thứ được đẩy ra một lần.
+ * Toạ độ đỉnh phải tính theo vị trí camera (các module tự dịch ma trận bằng -camera).
+ */
+public final class WorldRender3D {
+    private static boolean disabled;
+    private static boolean active;
+    private static VertexConsumerProvider.Immediate immediate;
+    private static RenderLayer quadLayer;
+    private static RenderLayer lineLayer;
+
+    private WorldRender3D() {
+    }
+
+    public static void register() {
+        WorldRenderEvents.END_MAIN.register(WorldRender3D::onEndMain);
+    }
+
+    private static void init() {
+        if (quadLayer != null) {
+            return;
+        }
+        final RenderPipeline quads = RenderPipelines.register(RenderPipeline.builder(RenderPipelines.POSITION_COLOR_SNIPPET)
+                .withLocation(Identifier.of("krypton", "pipeline/esp_quads"))
+                .withVertexFormat(VertexFormats.POSITION_COLOR, VertexFormat.DrawMode.QUADS)
+                .withDepthTestFunction(DepthTestFunction.NO_DEPTH_TEST)
+                .withBlend(BlendFunction.TRANSLUCENT)
+                .withCull(false)
+                .build());
+        final RenderPipeline lines = RenderPipelines.register(RenderPipeline.builder(RenderPipelines.RENDERTYPE_LINES_SNIPPET)
+                .withLocation(Identifier.of("krypton", "pipeline/esp_lines"))
+                .withVertexFormat(VertexFormats.POSITION_COLOR_NORMAL_LINE_WIDTH, VertexFormat.DrawMode.LINES)
+                .withDepthTestFunction(DepthTestFunction.NO_DEPTH_TEST)
+                .withBlend(BlendFunction.TRANSLUCENT)
+                .withCull(false)
+                .build());
+        final RenderLayer q = RenderLayer.of("krypton_esp_quads", RenderSetup.builder(quads).build());
+        final RenderLayer l = RenderLayer.of("krypton_esp_lines", RenderSetup.builder(lines).build());
+        final LinkedHashMap<RenderLayer, BufferAllocator> buffers = new LinkedHashMap<>();
+        buffers.put(q, new BufferAllocator(1 << 23));
+        buffers.put(l, new BufferAllocator(1 << 16));
+        immediate = VertexConsumerProvider.immediate(buffers, new BufferAllocator(1 << 12));
+        lineLayer = l;
+        quadLayer = q;
+    }
+
+    private static void onEndMain(final WorldRenderContext context) {
+        final MinecraftClient mc = Krypton.mc;
+        if (disabled || mc == null || mc.world == null || mc.player == null || Krypton.INSTANCE == null) {
+            return;
+        }
+        try {
+            init();
+            active = true;
+            EventManager.b(new Render3DEvent(new MatrixStack(), new Matrix4f(), 1.0f));
+            active = false;
+            immediate.draw();
+        } catch (final Throwable t) {
+            active = false;
+            disabled = true;
+            System.err.println("[Krypton] Ve 3D (ESP) bi tat do loi:");
+            t.printStackTrace(System.err);
+        }
+    }
+
+    public static void filledBox(final MatrixStack stack, final float x1, final float y1, final float z1, final float x2, final float y2, final float z2, final Color color) {
