+            .with(Blocks.GOLD_ORE, 0xFFFFD700)
+            .with(Blocks.DEEPSLATE_GOLD_ORE, 0xFFFFD700)
+            .with(Blocks.NETHER_GOLD_ORE, 0xFFFF9F1A);
+    {
+        this.blocks.setDescription(EncryptedString.of("Click to choose the blocks and their colors"));
+    }
+
+    private record Hit(BlockPos pos, Block block) {
+    }
+
+    private final Map<Long, List<Hit>> found = new ConcurrentHashMap<>();
+    private final Map<Long, Integer> lastScan = new ConcurrentHashMap<>();
+    private int tickCounter;
+    private int lastVersion = -1;
+    private Object lastWorld;
+
+    public BlockESP() {
+        super(EncryptedString.of("Block ESP"), EncryptedString.of("Highlights the blocks you choose, each with its own color"), -1, Category.RENDER);
+        this.addSettings(this.alpha, this.tracers, this.blocks);
+    }
+
+    @Override
+    public void onEnable() {
+        super.onEnable();
+        this.reset();
+    }
+
+    @Override
+    public void onDisable() {
+        super.onDisable();
+        this.reset();
+    }
+
+    private void reset() {
+        this.found.clear();
+        this.lastScan.clear();
+        this.tickCounter = 0;
+        this.lastVersion = -1;
+        this.lastWorld = null;
+    }
+
+    @EventListener
+    public void onTick(final TickEvent event) {
+        if (mc.world == null || mc.player == null) {
+            return;
+        }
+        ++this.tickCounter;
+        if (this.lastWorld != mc.world || this.lastVersion != this.blocks.getVersion()) {
+            this.lastWorld = mc.world;
+            this.lastVersion = this.blocks.getVersion();
+            this.found.clear();
+            this.lastScan.clear();
+        }
+        if (this.blocks.size() == 0) {
+            return;
+        }
+        // nearest chunks first, spreading outward from the player's own chunk
+        final ChunkPos center = mc.player.getChunkPos();
+        final List<WorldChunk> ordered = BlockUtil.getLoadedChunks()
+                .sorted(Comparator.comparingInt((WorldChunk c) -> {
+                    final int dx = c.getPos().x - center.x;
+                    final int dz = c.getPos().z - center.z;
+                    return dx * dx + dz * dz;
+                }))
+                .toList();
+        int budget = CHUNKS_PER_TICK;
+        for (final WorldChunk chunk : ordered) {
+            if (budget <= 0) {
+                break;
+            }
+            final long key = chunk.getPos().toLong();
+            final Integer last = this.lastScan.get(key);
+            if (last != null && this.tickCounter - last < RESCAN_TICKS) {
+                continue;
+            }
+            this.lastScan.put(key, this.tickCounter);
+            this.found.put(key, this.scanChunk(chunk));
+            --budget;
+        }
+        if (this.tickCounter % 200 == 0) {
+            this.found.keySet().removeIf(key -> {
+                final ChunkPos pos = new ChunkPos(key);
+                return !mc.world.isChunkLoaded(pos.x, pos.z);
+            });
+            this.lastScan.keySet().removeIf(key -> !this.found.containsKey(key));
+        }
+    }
+
+    private List<Hit> scanChunk(final WorldChunk chunk) {
+        final List<Hit> hits = new ArrayList<>();
+        final Map<Block, Integer> selected = this.blocks.getColors();
+        final ChunkSection[] sections = chunk.getSectionArray();
+        final int baseX = chunk.getPos().getStartX();
+        final int baseZ = chunk.getPos().getStartZ();
+        final int bottom = chunk.getBottomY();
+        for (int i = 0; i < sections.length; ++i) {
+            final ChunkSection section = sections[i];
+            // cheap palette check: skip sections that cannot contain any selected block
+            if (section == null || section.isEmpty() || !section.hasAny(state -> selected.containsKey(state.getBlock()))) {
+                continue;
+            }
+            final int baseY = bottom + i * 16;
+            for (int y = 0; y < 16; ++y) {
+                for (int z = 0; z < 16; ++z) {
+                    for (int x = 0; x < 16; ++x) {
+                        final Block block = section.getBlockState(x, y, z).getBlock();
+                        if (selected.containsKey(block)) {
+                            hits.add(new Hit(new BlockPos(baseX + x, baseY + y, baseZ + z), block));
+                            if (hits.size() >= MAX_PER_CHUNK) {
+                                return hits;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        return hits;
+    }
+
+    @EventListener
+    public void onRender3D(final Render3DEvent event) {
+        if (mc.world == null || mc.player == null || this.found.isEmpty()) {
+            return;
+        }
+        final Vec3d cam = RenderUtils.getCameraPos();
+        final List<Hit> hits = new ArrayList<>();
+        for (final List<Hit> list : this.found.values()) {
+            for (final Hit hit : list) {
+                if (this.blocks.isSelected(hit.block())) {
+                    hits.add(hit);
+                }
+            }
+        }
+        if (hits.isEmpty()) {
+            return;
+        }
+        hits.sort(Comparator.comparingDouble(h -> {
+            final double dx = h.pos().getX() + 0.5 - cam.x;
+            final double dy = h.pos().getY() + 0.5 - cam.y;
+            final double dz = h.pos().getZ() + 0.5 - cam.z;
+            return dx * dx + dy * dy + dz * dz;
+        }));
+        final MatrixStack matrices = event.matrixStack;
+        matrices.push();
+        matrices.translate(-cam.x, -cam.y, -cam.z);
+        final int fillAlpha = this.alpha.getIntValue();
+        final boolean drawTracers = this.tracers.getValue();
+        final int limit = Math.min(hits.size(), MAX_BOXES);
+        for (int i = 0; i < limit; ++i) {
+            final Hit hit = hits.get(i);
+            final Color color = new Color(this.blocks.getColor(hit.block()), true);
+            final BlockPos p = hit.pos();
+            final Color fill = new Color(color.getRed(), color.getGreen(), color.getBlue(), fillAlpha * color.getAlpha() / 255);
+            RenderUtils.renderFilledBox(matrices, p.getX(), p.getY(), p.getZ(), p.getX() + 1.0f, p.getY() + 1.0f, p.getZ() + 1.0f, fill);
+            if (drawTracers && i < MAX_TRACERS) {
+                RenderUtils.renderTracer(matrices, color, new Vec3d(p.getX() + 0.5, p.getY() + 0.5, p.getZ() + 0.5));
+            }
+        }
+        matrices.pop();
+    }
+}
