+package skid.krypton.gui.components;
+
+import net.minecraft.block.Block;
+import net.minecraft.block.Blocks;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.gui.DrawContext;
+import net.minecraft.client.gui.screen.Screen;
+import net.minecraft.item.Item;
+import net.minecraft.item.ItemStack;
+import net.minecraft.item.Items;
+import net.minecraft.registry.Registries;
+import net.minecraft.text.Text;
+import org.joml.Matrix3x2fStack;
+import skid.krypton.module.modules.client.Krypton;
+import skid.krypton.module.setting.BlockColorSetting;
+import skid.krypton.utils.RenderUtils;
+
+import java.awt.Color;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Block selection screen: search, ALL / SELECTED tabs and a grid of blocks.
+ * Left click toggles a block, right click (or click on its colour swatch) opens the colour picker.
+ */
+public final class BlockPicker extends Screen {
+    private static final int W = 900;
+    private static final int H = 680;
+    private static final int COLS = 10;
+    private static final int ROWS = 5;
+    private static final int CELL_W = 86;
+    private static final int CELL_H = 102;
+    private static final int GRID_X = 20;
+    private static final int GRID_Y = 120;
+    private static final int TILE = 56;
+
+    private static List<Block> ALL;
+    private static final Map<Block, String> NAMES = new HashMap<>();
+    private static final Map<Block, String> IDS = new HashMap<>();
+
+    private final BlockColorSetting setting;
+    private final BlockColorSetting.Snapshot snapshot;
+    private List<Block> filtered = new ArrayList<>();
+    private String query = "";
+    private boolean selectedOnly;
+    private double scrollTarget;
+    private double scrollPos;
+    private double tabAnim = 624.0;
+    private long lastNanos;
+    private float scale = 1.0f;
+    private int originX;
+    private int originY;
+    private double mouseX;
+    private double mouseY;
+
+    public BlockPicker(final BlockColorSetting setting) {
+        super(Text.empty());
+        this.setting = setting;
+        this.snapshot = setting.snapshot();
+        ensureBlocks();
+        this.refilter();
+    }
+
+    private static void ensureBlocks() {
+        if (ALL != null) {
+            return;
+        }
+        final List<Block> list = new ArrayList<>();
+        for (final Block block : Registries.BLOCK) {
+            if (block == Blocks.AIR || block == Blocks.CAVE_AIR || block == Blocks.VOID_AIR) {
+                continue;
+            }
+            final Item item = block.asItem();
+            if (item == Items.AIR) {
+                continue;
+            }
+            list.add(block);
+            NAMES.put(block, block.getName().getString().toUpperCase(Locale.ROOT));
+            IDS.put(block, Registries.BLOCK.getId(block).toString().toLowerCase(Locale.ROOT));
+        }
+        ALL = list;
+    }
+
+    // ------------------------------------------------------------------ layout / state
+    private void layout() {
+        final int ww = MinecraftClient.getInstance().getWindow().getWidth();
+        final int wh = MinecraftClient.getInstance().getWindow().getHeight();
+        this.scale = Math.max(0.3f, Math.min(1.0f, Math.min((ww - 40) / (float) W, (wh - 40) / (float) H)));
+        this.originX = (int) ((ww - W * this.scale) / 2.0f);
+        this.originY = (int) ((wh - H * this.scale) / 2.0f);
+    }
+
+    private double toDesignX(final double px) {
+        return (px - this.originX) / this.scale;
+    }
+
+    private double toDesignY(final double py) {
+        return (py - this.originY) / this.scale;
+    }
+
+    private void refilter() {
+        final String q = this.query.toLowerCase(Locale.ROOT).trim();
+        final List<Block> out = new ArrayList<>();
+        for (final Block block : ALL) {
+            if (this.selectedOnly && !this.setting.isSelected(block)) {
+                continue;
+            }
+            if (!q.isEmpty() && !NAMES.get(block).toLowerCase(Locale.ROOT).contains(q) && !IDS.get(block).contains(q)) {
+                continue;
+            }
+            out.add(block);
+        }
+        this.filtered = out;
+        this.clampScroll();
+    }
+
+    private static final int GRID_H = ROWS * CELL_H;
+
+    /** Maximum scroll offset in pixels. */
+    private double maxScroll() {
+        final int totalRows = (int) Math.ceil(this.filtered.size() / (double) COLS);
+        return Math.max(0, totalRows * CELL_H - GRID_H);
+    }
+
+    private void clampScroll() {
+        final double max = this.maxScroll();
+        this.scrollTarget = Math.max(0.0, Math.min(this.scrollTarget, max));
+        this.scrollPos = Math.max(0.0, Math.min(this.scrollPos, max));
+    }
+
+    private void done() {
+        MinecraftClient.getInstance().setScreen(skid.krypton.Krypton.INSTANCE.GUI);
+    }
+
+    private void cancel() {
+        this.setting.restore(this.snapshot);
+        MinecraftClient.getInstance().setScreen(skid.krypton.Krypton.INSTANCE.GUI);
+    }
+
+    private void openColor(final Block block) {
+        this.setting.select(block);
+        MinecraftClient.getInstance().setScreen(new ColorPicker(this, this.setting, block, NAMES.get(block)));
+    }
+
+    // ------------------------------------------------------------------ rendering
+    @Override
+    public void render(final DrawContext ctx, final int mx, final int my, final float delta) {
+        RenderUtils.currentContext = ctx;
+        RenderUtils.unscaledProjection();
+        final MinecraftClient mc = MinecraftClient.getInstance();
+        final double sf = mc.getWindow().getScaleFactor();
+        super.render(ctx, (int) (mx * sf), (int) (my * sf), delta);
+        this.layout();
+        this.mouseX = this.toDesignX(mx * sf);
+        this.mouseY = this.toDesignY(my * sf);
+        final long now = System.nanoTime();
+        final double dt = this.lastNanos == 0L ? 0.016 : Math.min(0.1, (now - this.lastNanos) / 1.0e9);
+        this.lastNanos = now;
+        this.scrollPos += (this.scrollTarget - this.scrollPos) * (1.0 - Math.exp(-dt * 16.0));
+        if (Math.abs(this.scrollTarget - this.scrollPos) < 0.05) {
+            this.scrollPos = this.scrollTarget;
+        }
+        this.tabAnim += ((this.selectedOnly ? 750.0 : 624.0) - this.tabAnim) * (1.0 - Math.exp(-dt * 20.0));
+        final int ww = mc.getWindow().getWidth();
+        final int wh = mc.getWindow().getHeight();
+        ctx.fill(0, 0, ww, wh, new Color(0, 0, 0, Krypton.renderBackground.getValue() ? 180 : 0).getRGB());
+
+        final Matrix3x2fStack m = ctx.getMatrices();
+        m.pushMatrix();
+        m.translate((float) this.originX, (float) this.originY);
+        m.scale(this.scale, this.scale);
+        this.drawPanel(ctx);
+        m.popMatrix();
+        RenderUtils.scaledProjection();
+    }
+
+    private void drawPanel(final DrawContext ctx) {
+        PickerUi.rounded(ctx, PickerUi.PANEL, 0, 0, W, H, 18);
+
+        // header
+        PickerUi.text(ctx, "CANCEL", 24, 22, PickerUi.ACCENT.getRGB(), 0.8f);
+        PickerUi.centered(ctx, "BLOCKS", W / 2.0, 21, Color.WHITE.getRGB(), 0.9f);
+        final String done = "DONE";
+        PickerUi.text(ctx, done, W - 24 - PickerUi.width(done, 0.8f), 22, PickerUi.ACCENT.getRGB(), 0.8f);
+
+        // search box
+        PickerUi.rounded(ctx, PickerUi.FIELD, 24, 76, 608, 118, 12);
+        PickerUi.outline(ctx, PickerUi.MUTED, 40, 91, 51, 102, 5, 1.5);
+        ctx.fill(49, 100, 52, 103, PickerUi.MUTED.getRGB());
+        ctx.fill(52, 103, 55, 106, PickerUi.MUTED.getRGB());
+        if (this.query.isEmpty()) {
+            PickerUi.text(ctx, "SEARCH", 66, 88, PickerUi.MUTED.getRGB(), 0.8f);
+        } else {
+            final String caret = System.currentTimeMillis() % 1000L > 500L ? "|" : "";
+            PickerUi.text(ctx, this.query.toUpperCase(Locale.ROOT) + caret, 66, 88, PickerUi.TEXT.getRGB(), 0.8f);
+        }
+
+        if (!this.query.isEmpty()) {
+            PickerUi.circle(ctx, PickerUi.TILE_HOVER, 589, 97, 10);
+            PickerUi.centered(ctx, "X", 589, 91, PickerUi.TEXT.getRGB(), 0.5f);
+        }
+
+        // ALL / SELECTED tabs
+        PickerUi.rounded(ctx, PickerUi.FIELD, 624, 76, 876, 118, 12);
+        final double activeX = this.tabAnim;
+        PickerUi.rounded(ctx, new Color(92, 94, 102, 255), activeX + 4, 80, activeX + 122, 114, 9);
+        PickerUi.centered(ctx, "ALL", 687, 88, PickerUi.TEXT.getRGB(), 0.8f);
+        PickerUi.centered(ctx, "SELECTED (" + this.setting.size() + ")", 813, 88, PickerUi.TEXT.getRGB(), 0.8f);
+
+        // grid (pixel-smooth scrolling, clipped to the grid area)
+        ctx.enableScissor(GRID_X - 6, GRID_Y, GRID_X + COLS * CELL_W + 6, GRID_Y + GRID_H);
+        final int firstRow = (int) Math.floor(this.scrollPos / CELL_H);
+        for (int row = firstRow; row <= firstRow + ROWS; ++row) {
+            final int y0 = (int) Math.round(GRID_Y + row * CELL_H - this.scrollPos);
+            for (int col = 0; col < COLS; ++col) {
+                final int index = row * COLS + col;
+                if (index >= this.filtered.size()) {
+                    break;
+                }
+                this.drawCell(ctx, this.filtered.get(index), GRID_X + col * CELL_W, y0);
+            }
+        }
+        ctx.disableScissor();
+        if (this.filtered.isEmpty()) {
+            PickerUi.centered(ctx, "NO BLOCKS FOUND", W / 2.0, GRID_Y + 200, PickerUi.MUTED.getRGB(), 0.9f);
+        }
+        if (this.maxScroll() > 0) {
+            final int trackH = GRID_H;
+            final int totalH = (int) Math.ceil(this.filtered.size() / (double) COLS) * CELL_H;
+            final int thumbH = Math.max(30, trackH * trackH / Math.max(1, totalH));
+            final int thumbY = GRID_Y + (int) ((trackH - thumbH) * (this.scrollPos / this.maxScroll()));
+            PickerUi.rounded(ctx, new Color(255, 255, 255, 20), 886, GRID_Y, 890, GRID_Y + trackH, 2);
+            PickerUi.rounded(ctx, new Color(255, 255, 255, 90), 886, thumbY, 890, thumbY + thumbH, 2);
+        }
+
+        // footer
+        ctx.fill(0, 632, W, 633, new Color(60, 62, 70, 255).getRGB());
+        PickerUi.text(ctx, "CLEAR ALL", 24, 648, PickerUi.DANGER.getRGB(), 0.8f);
+        final String selectAll = "SELECT ALL";
+        PickerUi.text(ctx, selectAll, W - 24 - PickerUi.width(selectAll, 0.8f), 648, PickerUi.ACCENT.getRGB(), 0.8f);
+        PickerUi.centered(ctx, this.setting.size() + " SELECTED", W / 2.0, 640, Color.WHITE.getRGB(), 0.75f);
+        PickerUi.centered(ctx, "CLICK A SWATCH OR RIGHT-CLICK TO CHANGE A COLOR", W / 2.0, 660, PickerUi.MUTED.getRGB(), 0.55f);
+    }
+
+    private void drawCell(final DrawContext ctx, final Block block, final int x0, final int y0) {
+        final int tx = x0 + (CELL_W - TILE) / 2;
+        final int ty = y0;
+        final boolean selected = this.setting.isSelected(block);
+        final boolean hover = PickerUi.inside(this.mouseX, this.mouseY, x0, y0, x0 + CELL_W, y0 + CELL_H)
+                && PickerUi.inside(this.mouseX, this.mouseY, GRID_X, GRID_Y, GRID_X + COLS * CELL_W, GRID_Y + ROWS * CELL_H);
+        PickerUi.rounded(ctx, hover ? PickerUi.TILE_HOVER : PickerUi.TILE, tx, ty, tx + TILE, ty + TILE, 12);
+        final ItemStack stack = new ItemStack(block.asItem());
+        RenderUtils.drawItem(ctx, stack, tx + 12, ty + 12, 32.0f, 0);
+        if (selected) {
+            final Color color = new Color(this.setting.getColor(block), true);
+            final Color solid = new Color(color.getRed(), color.getGreen(), color.getBlue(), 255);
+            PickerUi.outline(ctx, solid, tx, ty, tx + TILE, ty + TILE, 12, 2.0);
+            PickerUi.circle(ctx, new Color(20, 21, 25, 255), tx + TILE - 8, ty + TILE - 8, 11);
+            PickerUi.circle(ctx, solid, tx + TILE - 8, ty + TILE - 8, 9);
+        }
+        final List<String> lines = PickerUi.wrap(NAMES.get(block), CELL_W - 6, 0.62f, 2);
+        for (int i = 0; i < lines.size(); ++i) {
+            PickerUi.centered(ctx, lines.get(i), x0 + CELL_W / 2.0, ty + TILE + 8 + i * 14, selected ? PickerUi.TEXT.getRGB() : new Color(175, 177, 187).getRGB(), 0.62f);
+        }
+    }
+
+    // ------------------------------------------------------------------ input
+    @Override
+    public boolean mouseClicked(final net.minecraft.client.gui.Click click, final boolean doubled) {
+        return this.mouseClicked(click.x(), click.y(), click.button());
+    }
+
+    public boolean mouseClicked(final double rawX, final double rawY, final int button) {
+        final double sf = MinecraftClient.getInstance().getWindow().getScaleFactor();
+        final double x = this.toDesignX(rawX * sf);
+        final double y = this.toDesignY(rawY * sf);
+
+        if (PickerUi.inside(x, y, 12, 8, 120, 52) && button == 0) {
+            this.cancel();
+            return true;
+        }
+        if (PickerUi.inside(x, y, W - 120, 8, W - 12, 52) && button == 0) {
+            this.done();
+            return true;
+        }
+        if (!this.query.isEmpty() && PickerUi.inside(x, y, 573, 80, 605, 114) && button == 0) {
+            this.query = "";
+            this.scrollTarget = 0.0;
+            this.refilter();
+            return true;
+        }
+        if (PickerUi.inside(x, y, 624, 76, 750, 118) && button == 0) {
+            this.selectedOnly = false;
+            this.scrollTarget = 0.0;
+            this.refilter();
+            return true;
+        }
+        if (PickerUi.inside(x, y, 750, 76, 876, 118) && button == 0) {
+            this.selectedOnly = true;
+            this.scrollTarget = 0.0;
+            this.refilter();
+            return true;
+        }
+        if (PickerUi.inside(x, y, 12, 636, 150, 676) && button == 0) {
+            this.setting.clear();
+            this.refilter();
+            return true;
+        }
+        if (PickerUi.inside(x, y, W - 150, 636, W - 12, 676) && button == 0) {
+            this.setting.selectAll(this.filtered);
+            this.refilter();
+            return true;
+        }
+        if (PickerUi.inside(x, y, GRID_X, GRID_Y, GRID_X + COLS * CELL_W, GRID_Y + ROWS * CELL_H)) {
+            final int col = (int) ((x - GRID_X) / CELL_W);
+            final int row = (int) Math.floor((y - GRID_Y + this.scrollPos) / CELL_H);
+            final int index = row * COLS + col;
+            if (index >= 0 && index < this.filtered.size()) {
+                final Block block = this.filtered.get(index);
+                final int tx = GRID_X + col * CELL_W + (CELL_W - TILE) / 2;
+                final int ty = (int) Math.round(GRID_Y + row * CELL_H - this.scrollPos);
+                if (button == 1) {
+                    this.openColor(block);
+                } else if (button == 0) {
+                    final double dx = x - (tx + TILE - 8);
+                    final double dy = y - (ty + TILE - 8);
+                    if (this.setting.isSelected(block) && dx * dx + dy * dy <= 12 * 12) {
+                        this.openColor(block);
+                    } else {
+                        this.setting.toggle(block);
+                        if (this.selectedOnly) {
+                            this.refilter();
+                        }
+                    }
+                }
+            }
+            return true;
+        }
+        return true;
+    }
+
+    public boolean mouseScrolled(final double rawX, final double rawY, final double h, final double v) {
+        if (v != 0.0) {
+            this.scrollTarget = Math.max(0.0, Math.min(this.maxScroll(), this.scrollTarget - v * CELL_H * 0.8));
+        }
+        return true;
+    }
+
+    @Override
+    public boolean keyPressed(final net.minecraft.client.input.KeyInput input) {
+        return this.keyPressed(input.key(), input.scancode(), input.modifiers());
+    }
+
+    public boolean keyPressed(final int key, final int scancode, final int modifiers) {
+        if (key == 256) {
+            this.done();
+            return true;
+        }
+        if (key == 259) {
+            if (!this.query.isEmpty()) {
+                this.query = this.query.substring(0, this.query.length() - 1);
+                this.scrollTarget = 0.0;
+                this.refilter();
+            }
+            return true;
+        }
+        return true;
+    }
+
+    @Override
+    public boolean charTyped(final net.minecraft.client.input.CharInput input) {
+        return this.charTyped((char) input.codepoint(), input.modifiers());
+    }
+
+    public boolean charTyped(final char c, final int modifiers) {
+        if (c >= 32 && c != 127) {
+            this.query += c;
+            this.scrollTarget = 0.0;
+            this.refilter();
+        }
+        return true;
+    }
+
+    public void renderBackground(final DrawContext drawContext, final int n, final int n2, final float n3) {
+    }
+
+    public boolean shouldCloseOnEsc() {
+        return false;
+    }
+}
