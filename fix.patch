+    // ------------------------------------------------------------------ input
+    @Override
+    public boolean mouseClicked(final net.minecraft.client.gui.Click click, final boolean doubled) {
+        return this.mouseClicked(click.x(), click.y(), click.button());
+    }
+
+    public boolean mouseClicked(final double rawX, final double rawY, final int button) {
+        if (button != 0) {
+            return true;
+        }
+        final double sf = MinecraftClient.getInstance().getWindow().getScaleFactor();
+        final double x = this.toDesignX(rawX * sf);
+        final double y = this.toDesignY(rawY * sf);
+        if (this.tab == 2 && PickerUi.inside(x, y, HEX_FIELD_X, HEX_Y, HEX_FIELD_X + HEX_FIELD_W, HEX_Y + HEX_H)) {
+            if (!this.hexFocused) {
+                this.hexFocused = true;
+                this.hexFresh = true;
+                this.hexText = String.format("%06X", this.currentRgb());
+            }
+            return true;
+        }
+        if (this.hexFocused) {
+            this.commitHex();
+        }
+        if (PickerUi.inside(x, y, 12, 8, 120, 52)) {
+            this.back();
+            return true;
+        }
+        if (PickerUi.inside(x, y, W - 120, 8, W - 12, 52)) {
+            this.apply();
+            return true;
+        }
+        if (PickerUi.inside(x, y, 24, 66, 396, 98)) {
+            this.tab = Math.max(0, Math.min(2, (int) ((x - 24) / 124)));
+            return true;
+        }
+        if (PickerUi.inside(x, y, AREA_X - 4, ALPHA_Y - 4, AREA_X + ALPHA_W + 4, ALPHA_Y + ALPHA_H + 4)) {
+            this.dragging = DRAG_ALPHA;
+            this.drag(x, y);
+            return true;
+        }
+        if (this.tab == 0 && PickerUi.inside(x, y, AREA_X, AREA_Y, AREA_X + AREA_W, AREA_Y + AREA_H)) {
+            final int col = Math.min(GRID_COLS - 1, (int) ((x - AREA_X) / (AREA_W / GRID_COLS)));
+            final int row = Math.min(GRID_ROWS - 1, (int) ((y - AREA_Y) / (AREA_H / GRID_ROWS)));
+            this.setRgb(this.paletteColor(col, row));
+            return true;
+        }
+        if (this.tab == 1) {
+            if (PickerUi.inside(x, y, AREA_X - 8, AREA_Y - 8, AREA_X + AREA_W + 8, AREA_Y + AREA_H + 8)) {
+                this.dragging = DRAG_AREA;
+                this.drag(x, y);
+                return true;
+            }
+            if (PickerUi.inside(x, y, AREA_X - 8, HUE_Y - 4, AREA_X + AREA_W + 8, HUE_Y + HUE_H + 4)) {
+                this.dragging = DRAG_HUE;
+                this.drag(x, y);
+                return true;
+            }
+        }
+        if (this.tab == 2) {
+            for (int i = 0; i < 3; ++i) {
+                final int cy = this.sliderCy(i);
+                if (PickerUi.inside(x, y, SLIDER_X - 12, cy - 20, SLIDER_X + SLIDER_W + 12, cy + 20)) {
+                    this.dragging = DRAG_RED + i;
+                    this.drag(x, y);
+                    return true;
+                }
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public boolean mouseDragged(final net.minecraft.client.gui.Click click, final double dx, final double dy) {
+        if (this.dragging != DRAG_NONE) {
+            final double sf = MinecraftClient.getInstance().getWindow().getScaleFactor();
+            this.drag(this.toDesignX(click.x() * sf), this.toDesignY(click.y() * sf));
+            return true;
+        }
+        return true;
+    }
+
+    @Override
+    public boolean mouseReleased(final net.minecraft.client.gui.Click click) {
+        this.dragging = DRAG_NONE;
+        return true;
+    }
+
+    private void drag(final double x, final double y) {
+        switch (this.dragging) {
+            case DRAG_AREA -> {
+                this.sat = clamp01((x - AREA_X) / AREA_W);
+                this.val = 1.0f - clamp01((y - AREA_Y) / AREA_H);
+                this.syncRgb();
+            }
+            case DRAG_HUE -> {
+                this.hue = clamp01((x - AREA_X) / AREA_W);
+                this.syncRgb();
+            }
+            case DRAG_ALPHA -> this.alpha = Math.round(clamp01((x - AREA_X) / ALPHA_W) * 255.0f);
+            case DRAG_RED, DRAG_RED + 1, DRAG_RED + 2 -> {
+                final int channel = Math.round(clamp01((x - SLIDER_X - SLIDER_H / 2.0) / (SLIDER_W - SLIDER_H)) * 255.0f);
+                final int rgb = this.currentRgb();
+                int r = (rgb >> 16) & 255;
+                int g = (rgb >> 8) & 255;
+                int b = rgb & 255;
+                if (this.dragging == DRAG_RED) {
+                    r = channel;
+                } else if (this.dragging == DRAG_RED + 1) {
+                    g = channel;
+                } else {
+                    b = channel;
+                }
+                this.setRgb((r << 16) | (g << 8) | b);
+            }
+            default -> {
+            }
+        }
+    }
+
+    @Override
+    public boolean keyPressed(final net.minecraft.client.input.KeyInput input) {
+        return this.keyPressed(input.key(), input.scancode(), input.modifiers());
+    }
+
+    public boolean keyPressed(final int key, final int scancode, final int modifiers) {
+        if (this.hexFocused) {
+            if (key == 256) {
+                this.hexFocused = false;
+                this.hexFresh = false;
+            } else if (key == 257 || key == 335) {
+                this.commitHex();
+            } else if (key == 259) {
+                this.hexText = this.hexFresh || this.hexText.isEmpty() ? "" : this.hexText.substring(0, this.hexText.length() - 1);
+                this.hexFresh = false;
+                if (validHex(this.hexText)) {
+                    this.applyHex(this.hexText);
+                }
+            } else if (key == 86 && (modifiers & (2 | 8)) != 0) {
+                final String clip = MinecraftClient.getInstance().keyboard.getClipboard();
+                if (clip != null) {
+                    this.hexFresh = true;
+                    this.typeHex(clip.replace("#", "").trim());
+                }
+            }
+            return true;
+        }
+        if (key == 256) {
+            this.back();
+            return true;
+        }
+        if (key == 257) {
+            this.apply();
+            return true;
+        }
+        return true;
+    }
+
+    @Override
+    public boolean charTyped(final net.minecraft.client.input.CharInput input) {
+        return this.charTyped((char) input.codepoint(), input.modifiers());
+    }
+
+    public boolean charTyped(final char c, final int modifiers) {
+        if (this.hexFocused && c != '#') {
+            this.typeHex(String.valueOf(c));
+        }
+        return true;
+    }
+
+    public void renderBackground(final DrawContext drawContext, final int n, final int n2, final float n3) {
+    }
+
+    public boolean shouldCloseOnEsc() {
+        return false;
+    }
+}
