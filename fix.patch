+package skid.krypton.gui.components;
+
+import net.minecraft.client.gui.DrawContext;
+import skid.krypton.gui.Component;
+import skid.krypton.module.setting.BlockColorSetting;
+import skid.krypton.module.setting.Setting;
+import skid.krypton.utils.ColorUtil;
+import skid.krypton.utils.MathUtil;
+import skid.krypton.utils.RenderUtils;
+import skid.krypton.utils.TextRenderer;
+import skid.krypton.utils.Utils;
+
+import java.awt.Color;
+
+/** Row in the module settings: "Blocks    [15 COLORS]". Clicking it opens the block picker. */
+public final class BlockBox extends Component {
+    private static final Color TEXT_COLOR = new Color(230, 230, 230);
+    private static final Color HOVER_COLOR = new Color(255, 255, 255, 20);
+    private static final Color BUTTON_BG = new Color(36, 37, 44, 255);
+    private final BlockColorSetting setting;
+    private float hoverAnimation;
+
+    public BlockBox(final ModuleButton moduleButton, final Setting setting, final int offset) {
+        super(moduleButton, setting, offset);
+        this.setting = (BlockColorSetting) setting;
+    }
+
+    private String label() {
+        final int n = this.setting.size();
+        return n + (n == 1 ? " COLOR" : " COLORS");
+    }
+
+    @Override
+    public void render(final DrawContext drawContext, final int n, final int n2, final float n3) {
+        super.render(drawContext, n, n2, n3);
+        final float target = this.isHovered(n, n2) && !this.parent.parent.dragging ? 1.0f : 0.0f;
+        this.hoverAnimation = (float) MathUtil.exponentialInterpolate(this.hoverAnimation, target, 0.25, n3 * 0.05f);
+        final int top = this.parentY() + this.parentOffset() + this.offset;
+        if (!this.parent.parent.dragging) {
+            drawContext.fill(this.parentX(), top, this.parentX() + this.parentWidth(), top + this.parentHeight(), new Color(HOVER_COLOR.getRed(), HOVER_COLOR.getGreen(), HOVER_COLOR.getBlue(), (int) (HOVER_COLOR.getAlpha() * this.hoverAnimation)).getRGB());
+        }
+        TextRenderer.drawString(this.setting.getName(), drawContext, this.parentX() + 5, top + 9, TEXT_COLOR.getRGB());
+        final String text = this.label();
+        final int textWidth = TextRenderer.getWidth(text);
+        final int width = Math.max(80, textWidth + 16);
+        final int x = this.parentX() + this.parentWidth() - width - 5;
+        final int y = top + (this.parentHeight() - 20) / 2;
+        RenderUtils.renderRoundedQuad(drawContext.getMatrices(), BUTTON_BG, x, y, x + width, y + 20, 4.0, 4.0, 4.0, 4.0, 50.0);
+        if (this.overButton(n, n2)) {
+            final Color accent = Utils.getMainColor(255, this.parent.settings.indexOf(this));
+            RenderUtils.renderRoundedQuad(drawContext.getMatrices(), new Color(accent.getRed(), accent.getGreen(), accent.getBlue(), 50), x, y, x + width, y + 20, 4.0, 4.0, 4.0, 4.0, 50.0);
+        }
+        final Color accent = Utils.getMainColor(255, this.parent.settings.indexOf(this));
+        TextRenderer.drawString(text, drawContext, x + (width - textWidth) / 2, y + 3, ColorUtil.a(accent, Color.WHITE, 0.15f).getRGB());
+    }
+
+    private boolean overButton(final double mx, final double my) {
+        final int width = Math.max(80, TextRenderer.getWidth(this.label()) + 16);
+        final int x = this.parentX() + this.parentWidth() - width - 5;
+        final int y = this.parentY() + this.parentOffset() + this.offset + (this.parentHeight() - 20) / 2;
+        return mx >= x && mx <= x + width && my >= y && my <= y + 20;
+    }
+
+    @Override
+    public void mouseClicked(final double n, final double n2, final int n3) {
+        if (n3 == 0 && this.isHovered(n, n2)) {
+            this.mc.setScreen(new BlockPicker(this.setting));
+        }
+        super.mouseClicked(n, n2, n3);
+    }
+
+    @Override
+    public void onGuiClose() {
+        this.hoverAnimation = 0.0f;
+        super.onGuiClose();
+    }
+}
