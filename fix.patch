+    private static final int RESCAN_TICKS = 600;
+
+    private final NumberSetting alpha = new NumberSetting(EncryptedString.of("Alpha"), 1.0, 255.0, 125.0, 1.0);
+    private final NumberSetting minLight = new NumberSetting(EncryptedString.of("Min Light"), 1.0, 15.0, 7.0, 1.0)
+            .getValue(EncryptedString.of("Minimum light level of a block to count"));
+    private final NumberSetting maxY = new NumberSetting(EncryptedString.of("Max Y"), -64.0, 320.0, 40.0, 1.0)
+            .getValue(EncryptedString.of("Only look for lights below this height"));
+    private final NumberSetting minCount = new NumberSetting(EncryptedString.of("Min Count"), 1.0, 20.0, 2.0, 1.0)
+            .getValue(EncryptedString.of("Minimum number of lights in a chunk before it is shown"));
+    private final NumberSetting maxBoxes = new NumberSetting(EncryptedString.of("Max Boxes"), 10.0, 500.0, 150.0, 10.0)
+            .getValue(EncryptedString.of("Maximum number of boxes drawn (nearest first)"));
+    private final NumberSetting speed = new NumberSetting(EncryptedString.of("Scan Speed"), 1.0, 10.0, 2.0, 1.0)
+            .getValue(EncryptedString.of("Chunks scanned per tick"));
+    private final BooleanSetting undergroundOnly = new BooleanSetting(EncryptedString.of("Underground Only"), true)
+            .setDescription(EncryptedString.of("Ignore lights that can see the sky"));
+    private final BooleanSetting ignoreTorches = new BooleanSetting(EncryptedString.of("Ignore Torches"), false)
+            .setDescription(EncryptedString.of("Skip torches (mineshafts are full of them)"));
+    private final BooleanSetting tracers = new BooleanSetting(EncryptedString.of("Tracers"), false)
+            .setDescription(EncryptedString.of("Draws a line to each light"));
+
+    private final BooleanSetting volumeMode = new BooleanSetting(EncryptedString.of("Light Volume"), true)
+            .setDescription(EncryptedString.of("Shows lit areas as translucent blocks instead of single lights"));
+    private final NumberSetting volumeMin = new NumberSetting(EncryptedString.of("Volume Min"), 1.0, 15.0, 3.0, 1.0)
+            .getValue(EncryptedString.of("Minimum block light level shown in Light Volume"));
+    private final NumberSetting lockY = new NumberSetting(EncryptedString.of("Lock Y"), -64.0, 320.0, -1.0, 1.0)
+            .getValue(EncryptedString.of("Light Volume only shows blocks at this Y level and below"));
+    private final NumberSetting maxQuads = new NumberSetting(EncryptedString.of("Max Quads"), 1000.0, 100000.0, 15000.0, 1000.0)
+            .getValue(EncryptedString.of("Maximum faces drawn per frame (lower = faster)"));
+    private final NumberSetting radius = new NumberSetting(EncryptedString.of("Radius"), 2.0, 32.0, 10.0, 1.0)
+            .getValue(EncryptedString.of("Chunk radius drawn in Light Volume"));
+
+    private final Map<Long, int[]> volume = new ConcurrentHashMap<>();
+    private boolean lastMode;
+    private int lastLock = Integer.MIN_VALUE;
+    private final Map<Long, List<BlockPos>> results = new ConcurrentHashMap<>();
+    private final Map<Long, Integer> lastScan = new ConcurrentHashMap<>();
+    private int tickCounter;
+
+    public LightFinder() {
+        super(EncryptedString.of("Light Finder"), EncryptedString.of("Finds artificial lights underground"), -1, Category.DONUT);
+        this.addSettings(this.volumeMode, this.lockY, this.volumeMin, this.maxQuads, this.radius, this.alpha, this.minLight, this.maxY, this.minCount, this.maxBoxes, this.speed, this.undergroundOnly, this.ignoreTorches, this.tracers);
+    }
+
+    @Override
+    public void onEnable() {
+        super.onEnable();
+        this.results.clear();
+        this.volume.clear();
+        this.lastScan.clear();
+        this.tickCounter = 0;
+    }
+
+    @Override
+    public void onDisable() {
+        super.onDisable();
+        this.results.clear();
+        this.volume.clear();
+        this.lastScan.clear();
+    }
+
+    @EventListener
+    public void onTick(final TickEvent event) {
+        if (mc.world == null || mc.player == null) {
+            return;
+        }
+        ++this.tickCounter;
+        if (mc.world.getRegistryKey() != World.OVERWORLD) {
+            this.results.clear();
+            this.volume.clear();
+            this.lastScan.clear();
+            return;
+        }
+        final boolean vol = this.volumeMode.getValue();
+        final int lock = this.lockY.getIntValue();
+        if (vol != this.lastMode || lock != this.lastLock) {
+            this.lastMode = vol;
+            this.lastLock = lock;
+            this.results.clear();
+            this.volume.clear();
+            this.lastScan.clear();
+        }
+        int budget = vol ? Math.max(1, this.speed.getIntValue() / 2) : this.speed.getIntValue();
+        // Scan outward from the player's own chunk: nearest chunks first, then the rings around them.
+        final ChunkPos center = mc.player.getChunkPos();
+        final List<WorldChunk> ordered = BlockUtil.getLoadedChunks()
+                .sorted(Comparator.comparingInt((WorldChunk c) -> {
+                    final int dx = c.getPos().x - center.x;
+                    final int dz = c.getPos().z - center.z;
+                    return dx * dx + dz * dz;
+                }))
+                .toList();
+        for (final WorldChunk chunk : ordered) {
+            if (budget <= 0) {
+                break;
+            }
+            final long key = chunk.getPos().toLong();
+            final Integer last = this.lastScan.get(key);
+            if (last != null && this.tickCounter - last < RESCAN_TICKS) {
+                continue;
+            }
+            this.lastScan.put(key, this.tickCounter);
+            if (vol) {
+                this.volume.put(key, this.scanVolume(chunk));
+            } else {
+                this.results.put(key, this.scanChunk(chunk));
+            }
+            --budget;
+        }
+        if (this.tickCounter % 200 == 0) {
+            this.results.keySet().removeIf(key -> {
+                final ChunkPos pos = new ChunkPos(key);
+                return !mc.world.isChunkLoaded(pos.x, pos.z);
+            });
+            this.volume.keySet().removeIf(key -> {
+                final ChunkPos pos = new ChunkPos(key);
+                return !mc.world.isChunkLoaded(pos.x, pos.z);
+            });
+            this.lastScan.keySet().removeIf(key -> !this.results.containsKey(key) && !this.volume.containsKey(key));
+        }
+    }
+
+    /** Doc anh sang khoi cua chunk tu du lieu server gui (khong can biet khoi nao) va tao cac mat ngoai cua vung sang. */
+    private int[] scanVolume(final WorldChunk chunk) {
+        final int minLevel = this.volumeMin.getIntValue();
+        final int bottom = mc.world.getBottomY();
+        final int top = Math.min(this.lockY.getIntValue(), bottom + mc.world.getHeight() - 1);
+        final int rows = top - bottom + 1;
+        if (rows <= 0) {
+            return new int[0];
+        }
+        final byte[] levels = new byte[rows * 256];
+        final var view = mc.world.getLightingProvider().get(LightType.BLOCK);
+        final int cx = chunk.getPos().x;
+        final int cz = chunk.getPos().z;
+        boolean any = false;
+        for (int sy = bottom >> 4; sy <= (top >> 4); ++sy) {
+            final var section = view.getLightSection(ChunkSectionPos.from(cx, sy, cz));
+            if (section == null) {
+                continue;
+            }
+            for (int ly = 0; ly < 16; ++ly) {
+                final int wy = (sy << 4) + ly;
+                if (wy < bottom || wy > top) {
+                    continue;
+                }
+                for (int lz = 0; lz < 16; ++lz) {
+                    for (int lx = 0; lx < 16; ++lx) {
+                        final int level = section.get(lx, ly, lz);
+                        if (level >= minLevel) {
+                            levels[((wy - bottom) * 16 + lz) * 16 + lx] = (byte) level;
+                            any = true;
+                        }
+                    }
+                }
+            }
+        }
+        if (!any) {
+            return new int[0];
+        }
+        final int baseX = chunk.getPos().getStartX();
+        final int baseZ = chunk.getPos().getStartZ();
+        int[] out = new int[4096];
+        int n = 0;
+        final int cap = 4 * 12000;
+        for (int y = 0; y < rows && n < cap; ++y) {
+            for (int z = 0; z < 16; ++z) {
+                for (int x = 0; x < 16; ++x) {
+                    final int idx = (y * 16 + z) * 16 + x;
+                    final int level = levels[idx];
+                    if (level == 0) {
+                        continue;
+                    }
+                    for (int dir = 0; dir < 6; ++dir) {
+                        final int neighbour = switch (dir) {
+                            case 0 -> y > 0 ? levels[idx - 256] : 0;
+                            case 1 -> y < rows - 1 ? levels[idx + 256] : 0;
+                            case 2 -> z > 0 ? levels[idx - 16] : 0;
+                            case 3 -> z < 15 ? levels[idx + 16] : 0;
+                            case 4 -> x > 0 ? levels[idx - 1] : 0;
+                            default -> x < 15 ? levels[idx + 1] : 0;
+                        };
+                        if (neighbour != 0) {
+                            continue;
+                        }
+                        if (n + 4 > out.length) {
+                            out = Arrays.copyOf(out, out.length * 2);
+                        }
+                        out[n++] = baseX + x;
+                        out[n++] = bottom + y;
+                        out[n++] = baseZ + z;
+                        out[n++] = dir | (level << 4);
+                    }
+                }
+            }
+        }
+        return Arrays.copyOf(out, n);
+    }
+
+    private void renderVolume(final Render3DEvent event, final Vec3d cam) {
+        if (this.volume.isEmpty()) {
+            return;
+        }
+        final double maxDist = this.radius.getIntValue() * 16.0;
+        final double px = mc.player.getX();
+        final double pz = mc.player.getZ();
+        final List<Map.Entry<Long, int[]>> chunks = new ArrayList<>();
+        for (final Map.Entry<Long, int[]> entry : this.volume.entrySet()) {
+            if (entry.getValue().length == 0) {
+                continue;
+            }
+            final ChunkPos cp = new ChunkPos(entry.getKey());
+            final double dx = cp.getCenterX() - px;
+            final double dz = cp.getCenterZ() - pz;
+            if (dx * dx + dz * dz <= maxDist * maxDist) {
+                chunks.add(entry);
+            }
+        }
+        chunks.sort(Comparator.comparingDouble(entry -> {
+            final ChunkPos cp = new ChunkPos(entry.getKey());
+            final double dx = cp.getCenterX() - px;
+            final double dz = cp.getCenterZ() - pz;
+            return dx * dx + dz * dz;
+        }));
+        final MatrixStack matrices = event.matrixStack;
+        matrices.push();
+        matrices.translate(-cam.x, -cam.y, -cam.z);
+        final int alphaValue = this.alpha.getIntValue();
+        final int yLimit = this.lockY.getIntValue();
+        int quads = 0;
+        final int budget = this.maxQuads.getIntValue();
+        outer:
+        for (final Map.Entry<Long, int[]> entry : chunks) {
+            final int[] faces = entry.getValue();
+            for (int i = 0; i + 3 < faces.length; i += 4) {
+                if (quads >= budget) {
+                    break outer;
+                }
+                if (faces[i + 1] > yLimit) {
+                    continue;
+                }
+                final int info = faces[i + 3];
+                final int level = info >> 4;
+                final int shade = Math.min(255, 70 + level * 12);
+                WorldRender3D.faceQuad(matrices, faces[i], faces[i + 1], faces[i + 2], info & 15, shade, shade, shade, alphaValue);
+                ++quads;
+            }
+        }
+        matrices.pop();
+    }
+
+    private List<BlockPos> scanChunk(final WorldChunk chunk) {
+        final List<BlockPos> found = new ArrayList<>();
+        final int minLevel = this.minLight.getIntValue();
+        final int bottom = mc.world.getBottomY();
+        final int top = Math.min(this.maxY.getIntValue(), bottom + mc.world.getHeight() - 1);
+        final boolean underground = this.undergroundOnly.getValue();
+        final boolean skipTorches = this.ignoreTorches.getValue();
+        final int baseX = chunk.getPos().getStartX();
+        final int baseZ = chunk.getPos().getStartZ();
+        final BlockPos.Mutable pos = new BlockPos.Mutable();
+        for (int y = bottom; y <= top; ++y) {
+            for (int x = 0; x < 16; ++x) {
+                for (int z = 0; z < 16; ++z) {
+                    pos.set(baseX + x, y, baseZ + z);
+                    final BlockState state = chunk.getBlockState(pos);
+                    if (state.getLuminance() < minLevel || isNatural(state)) {
+                        continue;
+                    }
+                    if (skipTorches && isTorch(state)) {
+                        continue;
+                    }
+                    if (underground && mc.world.getLightLevel(LightType.SKY, pos) > 0) {
+                        continue;
+                    }
+                    found.add(pos.toImmutable());
+                }
+            }
+        }
+        return found;
+    }
+
+    private static boolean isTorch(final BlockState state) {
+        return state.isOf(Blocks.TORCH) || state.isOf(Blocks.WALL_TORCH) || state.isOf(Blocks.SOUL_TORCH) || state.isOf(Blocks.SOUL_WALL_TORCH);
+    }
+
+    /** Cac nguon sang xuat hien tu nhien duoi long dat. */
+    private static boolean isNatural(final BlockState state) {
+        return state.isOf(Blocks.LAVA) || state.isOf(Blocks.MAGMA_BLOCK) || state.isOf(Blocks.GLOW_LICHEN)
+                || state.isOf(Blocks.AMETHYST_CLUSTER) || state.isOf(Blocks.LARGE_AMETHYST_BUD)
+                || state.isOf(Blocks.MEDIUM_AMETHYST_BUD) || state.isOf(Blocks.SMALL_AMETHYST_BUD)
+                || state.isOf(Blocks.CAVE_VINES) || state.isOf(Blocks.CAVE_VINES_PLANT)
+                || state.isOf(Blocks.FIRE) || state.isOf(Blocks.SOUL_FIRE) || state.isOf(Blocks.SEA_PICKLE)
+                || state.isOf(Blocks.SCULK_CATALYST) || state.isOf(Blocks.CRYING_OBSIDIAN)
+                || state.isOf(Blocks.REDSTONE_ORE) || state.isOf(Blocks.DEEPSLATE_REDSTONE_ORE);
+    }
+
+    @EventListener
+    public void onRender3D(final Render3DEvent event) {
+        if (mc.world == null || mc.player == null) {
+            return;
+        }
+        final Vec3d cam = RenderUtils.getCameraPos();
+        if (this.volumeMode.getValue()) {
+            this.renderVolume(event, cam);
+            return;
+        }
+        if (this.results.isEmpty()) {
+            return;
+        }
+        final int need = this.minCount.getIntValue();
+        final List<BlockPos> all = new ArrayList<>();
+        for (final List<BlockPos> list : this.results.values()) {
+            if (list.size() >= need) {
+                all.addAll(list);
+            }
+        }
+        if (all.isEmpty()) {
+            return;
+        }
+        all.sort(Comparator.comparingDouble(p -> {
+            final double dx = p.getX() + 0.5 - cam.x;
+            final double dy = p.getY() + 0.5 - cam.y;
+            final double dz = p.getZ() + 0.5 - cam.z;
+            return dx * dx + dy * dy + dz * dz;
+        }));
+        final MatrixStack matrices = event.matrixStack;
+        matrices.push();
+        matrices.translate(-cam.x, -cam.y, -cam.z);
+        final Color fill = new Color(255, 200, 0, this.alpha.getIntValue());
+        final Color line = new Color(255, 200, 0, 255);
+        final Vec3d look = mc.player.getRotationVec(1.0f);
+        final Vec3d start = cam.add(look);
+        final int limit = Math.min(all.size(), this.maxBoxes.getIntValue());
+        for (int i = 0; i < limit; ++i) {
+            final BlockPos p = all.get(i);
+            RenderUtils.renderFilledBox(matrices, p.getX() + 0.25f, p.getY() + 0.25f, p.getZ() + 0.25f, p.getX() + 0.75f, p.getY() + 0.75f, p.getZ() + 0.75f, fill);
+            if (this.tracers.getValue()) {
+                RenderUtils.renderLine(matrices, line, start, new Vec3d(p.getX() + 0.5, p.getY() + 0.5, p.getZ() + 0.5));
+            }
+        }
+        matrices.pop();
+    }
+}
