+package skid.krypton.module.modules.render;
+
+import skid.krypton.module.Category;
+import skid.krypton.module.Module;
+import skid.krypton.module.setting.NumberSetting;
+import skid.krypton.utils.EncryptedString;
+
+/**
+ * SwingSpeed: changes how fast your own swing animation plays (visual only, nothing is sent to the server).
+ * The actual work is done in LivingEntityMixin, which asks {@link #getSwingDuration(int)} for the swing length.
+ */
+public final class SwingSpeed extends Module {
+    private final NumberSetting speed = new NumberSetting(EncryptedString.of("Speed"), 1.0, 20.0, 10.0, 1.0);
+
+    public SwingSpeed() {
+        super(EncryptedString.of("SwingSpeed"), EncryptedString.of("Modifies your swing animation speed (visual only)"), -1, Category.RENDER);
+        this.addSettings(this.speed);
+    }
+
+    /**
+     * Swing length in ticks. Speed 5 is the vanilla speed (6 ticks), higher is faster, lower is slower,
+     * speed 20 gives a 2 tick swing.
+     */
+    public int getSwingDuration(final int vanilla) {
+        return Math.max(1, (int) Math.round(30.0 / this.speed.getValue()));
+    }
+}
