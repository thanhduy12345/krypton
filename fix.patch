+package skid.krypton.gui.components;
+
+import net.minecraft.client.gui.DrawContext;
+import net.minecraft.text.Style;
+import net.minecraft.text.StyleSpriteSource;
+import net.minecraft.text.Text;
+import net.minecraft.util.Identifier;
+import org.joml.Matrix3x2fStack;
+import skid.krypton.utils.RenderUtils;
+import skid.krypton.utils.TextRenderer;
+
+import java.awt.Color;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Small drawing helpers shared by the block picker and the colour picker. */
+final class PickerUi {
+    static final Color ACCENT = new Color(70, 140, 255);
+    static final Color DANGER = new Color(235, 85, 85);
+    static final Color PANEL = new Color(24, 25, 30, 245);
+    static final Color FIELD = new Color(45, 46, 52, 255);
+    static final Color TILE = new Color(48, 49, 56, 255);
+    static final Color TILE_HOVER = new Color(62, 64, 72, 255);
+    static final Color TEXT = new Color(235, 236, 240, 255);
+    static final Color MUTED = new Color(130, 132, 142, 255);
+
+    private PickerUi() {
+    }
+
+    // Text is drawn with a font rasterised at the exact pixel size (assets/krypton/font/pNN.json), so it is drawn
+    // 1:1 and stays sharp. Scaling the HUD-size font by 0.55 - 0.9 made it blurry.
+    private static final Map<Integer, Style> STYLES = new HashMap<>();
+
+    private static boolean customFont() {
+        return skid.krypton.module.modules.client.Krypton.useCustomFont.getValue();
+    }
+
+    private static int pixelSize(final float scale) {
+        return Math.max(8, Math.min(20, Math.round(18.0f * scale)));
+    }
+
+    private static Text crisp(final CharSequence s, final int size) {
+        final Style style = STYLES.computeIfAbsent(size, k -> Style.EMPTY.withFont(new StyleSpriteSource.Font(Identifier.of("krypton", "p" + k))));
+        return Text.literal(s.toString()).setStyle(style);
+    }
+
+    static void text(final DrawContext ctx, final CharSequence s, final double x, final double y, final int rgb, final float scale) {
+        if (!customFont()) {
+            final Matrix3x2fStack m = ctx.getMatrices();
+            m.pushMatrix();
+            m.translate((float) x, (float) y);
+            m.scale(scale, scale);
+            TextRenderer.drawString(s, ctx, 0, 0, rgb);
+            m.popMatrix();
+            return;
+        }
+        final Text t = crisp(s, pixelSize(scale));
+        final int color = (rgb & 0xFC000000) == 0 ? (rgb | 0xFF000000) : rgb;
+        final int shadow = ((color & 0xFCFCFC) >> 2) | (color & 0xFF000000);
+        final int ix = (int) Math.round(x);
+        final int iy = (int) Math.round(y);
+        ctx.drawText(skid.krypton.Krypton.mc.textRenderer, t, ix + 1, iy, shadow, false);
+        ctx.drawText(skid.krypton.Krypton.mc.textRenderer, t, ix, iy - 1, color, false);
+    }
+
+    static int width(final CharSequence s, final float scale) {
+        if (!customFont()) {
+            return (int) (TextRenderer.getWidth(s) * scale);
+        }
+        return skid.krypton.Krypton.mc.textRenderer.getWidth(crisp(s, pixelSize(scale)));
+    }
+
+    static void centered(final DrawContext ctx, final CharSequence s, final double cx, final double y, final int rgb, final float scale) {
+        text(ctx, s, cx - width(s, scale) / 2.0, y, rgb, scale);
+    }
+
+    static void rounded(final DrawContext ctx, final Color color, final double x1, final double y1, final double x2, final double y2, final double r) {
+        RenderUtils.renderRoundedQuad(ctx.getMatrices(), color, x1, y1, x2, y2, r, r, r, r, 20.0);
+    }
+
+    static void outline(final DrawContext ctx, final Color color, final double x1, final double y1, final double x2, final double y2, final double r, final double thickness) {
+        RenderUtils.renderRoundedOutline(ctx, color, x1, y1, x2, y2, r, r, r, r, thickness, 20.0);
+    }
+
+    static void circle(final DrawContext ctx, final Color color, final double cx, final double cy, final double radius) {
+        RenderUtils.renderCircle(ctx.getMatrices(), color, cx, cy, radius, 24);
+    }
+
+    static boolean inside(final double px, final double py, final double x1, final double y1, final double x2, final double y2) {
+        return px >= x1 && px < x2 && py >= y1 && py < y2;
+    }
+
+    /** Splits text on spaces into at most maxLines lines; a word that is too wide is broken by characters. */
+    static List<String> wrap(final String text, final int maxWidth, final float scale, final int maxLines) {
+        final List<String> lines = new ArrayList<>();
+        StringBuilder line = new StringBuilder();
+        for (final String word : text.split(" ")) {
+            String rest = word;
+            while (!rest.isEmpty()) {
+                final String candidate = line.length() == 0 ? rest : line + " " + rest;
+                if (width(candidate, scale) <= maxWidth) {
+                    line = new StringBuilder(candidate);
+                    rest = "";
+                } else if (line.length() > 0) {
+                    lines.add(line.toString());
+                    line = new StringBuilder();
+                } else {
+                    int cut = rest.length();
+                    while (cut > 1 && width(rest.substring(0, cut), scale) > maxWidth) {
+                        --cut;
+                    }
+                    lines.add(rest.substring(0, cut));
+                    rest = rest.substring(cut);
+                }
+            }
+        }
+        if (line.length() > 0) {
+            lines.add(line.toString());
+        }
+        while (lines.size() > maxLines) {
+            lines.remove(lines.size() - 1);
+        }
+        return lines;
+    }
+}
