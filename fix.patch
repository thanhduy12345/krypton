--- a/src/main/java/skid/krypton/module/setting/BlockColorSetting.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/skid/krypton/module/setting/BlockColorSetting.java	2026-11-25 08:58:06.175924967 +0000
@@ -0,0 +1,137 @@
+package skid.krypton.module.setting;
+
+import net.minecraft.block.Block;
+import net.minecraft.registry.Registries;
+
+import java.awt.Color;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * A set of selected blocks, each one with its own ARGB colour (used by Block ESP).
+ * "version" only changes when the set of selected blocks changes, not when a colour changes.
+ */
+public class BlockColorSetting extends Setting {
+    private final LinkedHashMap<Block, Integer> colors = new LinkedHashMap<>();
+    // Last colour the user picked for a block, remembered even while the block is deselected.
+    private final LinkedHashMap<Block, Integer> custom = new LinkedHashMap<>();
+    private final LinkedHashMap<Block, Integer> defaults = new LinkedHashMap<>();
+    private int version;
+
+    public BlockColorSetting(final CharSequence name) {
+        super(name);
+    }
+
+    /** Adds a block that is selected by default. */
+    public BlockColorSetting with(final Block block, final int argb) {
+        this.colors.put(block, argb);
+        this.custom.put(block, argb);
+        this.defaults.put(block, argb);
+        return this;
+    }
+
+    public static int defaultColor(final Block block) {
+        final int hash = Registries.BLOCK.getId(block).toString().hashCode();
+        final float hue = Math.floorMod(hash, 360) / 360.0f;
+        return Color.HSBtoRGB(hue, 0.65f, 1.0f) | 0xFF000000;
+    }
+
+    public boolean isSelected(final Block block) {
+        return this.colors.containsKey(block);
+    }
+
+    public int getColor(final Block block) {
+        final Integer selected = this.colors.get(block);
+        if (selected != null) {
+            return selected;
+        }
+        final Integer remembered = this.custom.get(block);
+        return remembered != null ? remembered : defaultColor(block);
+    }
+
+    /** Sets the colour of a block and selects it. */
+    public void setColor(final Block block, final int argb) {
+        if (!this.colors.containsKey(block)) {
+            ++this.version;
+        }
+        this.colors.put(block, argb);
+        this.custom.put(block, argb);
+    }
+
+    public void select(final Block block) {
+        if (!this.colors.containsKey(block)) {
+            this.colors.put(block, this.getColor(block));
+            ++this.version;
+        }
+    }
+
+    public void deselect(final Block block) {
+        if (this.colors.remove(block) != null) {
+            ++this.version;
+        }
+    }
+
+    public void toggle(final Block block) {
+        if (this.isSelected(block)) {
+            this.deselect(block);
+        } else {
+            this.select(block);
+        }
+    }
+
+    public void selectAll(final Collection<Block> blocks) {
+        for (final Block block : blocks) {
+            this.select(block);
+        }
+    }
+
+    public void clear() {
+        if (!this.colors.isEmpty()) {
+            this.colors.clear();
+            ++this.version;
+        }
+    }
+
+    public int size() {
+        return this.colors.size();
+    }
+
+    public int getVersion() {
+        return this.version;
+    }
+
+    /** Read-only view of the selected blocks and their ARGB colours. */
+    public Map<Block, Integer> getColors() {
+        return Collections.unmodifiableMap(this.colors);
+    }
+
+    public Snapshot snapshot() {
+        return new Snapshot(new LinkedHashMap<>(this.colors), new LinkedHashMap<>(this.custom));
+    }
+
+    public void restore(final Snapshot snapshot) {
+        this.colors.clear();
+        this.colors.putAll(snapshot.colors);
+        this.custom.clear();
+        this.custom.putAll(snapshot.custom);
+        ++this.version;
+    }
+
+    public void resetValue() {
+        this.colors.clear();
+        this.colors.putAll(this.defaults);
+        ++this.version;
+    }
+
+    public static final class Snapshot {
+        private final LinkedHashMap<Block, Integer> colors;
+        private final LinkedHashMap<Block, Integer> custom;
+
+        private Snapshot(final LinkedHashMap<Block, Integer> colors, final LinkedHashMap<Block, Integer> custom) {
+            this.colors = colors;
+            this.custom = custom;
+        }
+    }
+}
