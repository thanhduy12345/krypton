diff -ruN a/src/main/java/skid/krypton/utils/WorldRender3D.java b/src/main/java/skid/krypton/utils/WorldRender3D.java
--- a/src/main/java/skid/krypton/utils/WorldRender3D.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/skid/krypton/utils/WorldRender3D.java	2026-11-25 08:58:06.177260753 +0000
@@ -0,0 +1,168 @@
+package skid.krypton.utils;
+
+import com.mojang.blaze3d.pipeline.BlendFunction;
+import com.mojang.blaze3d.pipeline.RenderPipeline;
+import com.mojang.blaze3d.platform.DepthTestFunction;
+import com.mojang.blaze3d.vertex.VertexFormat;
+import net.fabricmc.fabric.api.client.rendering.v1.world.WorldRenderContext;
+import net.fabricmc.fabric.api.client.rendering.v1.world.WorldRenderEvents;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.gl.RenderPipelines;
+import net.minecraft.client.render.RenderLayer;
+import net.minecraft.client.render.RenderSetup;
+import net.minecraft.client.render.VertexConsumer;
+import net.minecraft.client.render.VertexConsumerProvider;
+import net.minecraft.client.render.VertexFormats;
+import net.minecraft.client.util.BufferAllocator;
+import net.minecraft.client.util.math.MatrixStack;
+import net.minecraft.util.Identifier;
+import net.minecraft.util.math.Vec3d;
+import org.joml.Matrix4f;
+import skid.krypton.Krypton;
+import skid.krypton.event.events.Render3DEvent;
+import skid.krypton.manager.EventManager;
+
+import java.awt.Color;
+import java.util.LinkedHashMap;
+
+/**
+ * Vẽ 3D (ESP) cho 1.21.11: hộp tô màu và đường tracer, nhìn xuyên tường.
+ * Mỗi khung hình, sự kiện END_MAIN của Fabric gọi Render3DEvent cho các module,
+ * các module vẽ qua RenderUtils.renderFilledBox / renderLine, sau đó mọi thứ được đẩy ra một lần.
+ * Toạ độ đỉnh phải tính theo vị trí camera (các module tự dịch ma trận bằng -camera).
+ */
+public final class WorldRender3D {
+    private static boolean disabled;
+    private static boolean active;
+    private static VertexConsumerProvider.Immediate immediate;
+    private static RenderLayer quadLayer;
+    private static RenderLayer lineLayer;
+
+    private WorldRender3D() {
+    }
+
+    public static void register() {
+        WorldRenderEvents.END_MAIN.register(WorldRender3D::onEndMain);
+    }
+
+    private static void init() {
+        if (quadLayer != null) {
+            return;
+        }
+        final RenderPipeline quads = RenderPipelines.register(RenderPipeline.builder(RenderPipelines.POSITION_COLOR_SNIPPET)
+                .withLocation(Identifier.of("krypton", "pipeline/esp_quads"))
+                .withVertexFormat(VertexFormats.POSITION_COLOR, VertexFormat.DrawMode.QUADS)
+                .withDepthTestFunction(DepthTestFunction.NO_DEPTH_TEST)
+                .withBlend(BlendFunction.TRANSLUCENT)
+                .withCull(false)
+                .build());
+        final RenderPipeline lines = RenderPipelines.register(RenderPipeline.builder(RenderPipelines.RENDERTYPE_LINES_SNIPPET)
+                .withLocation(Identifier.of("krypton", "pipeline/esp_lines"))
+                .withVertexFormat(VertexFormats.POSITION_COLOR_NORMAL_LINE_WIDTH, VertexFormat.DrawMode.LINES)
+                .withDepthTestFunction(DepthTestFunction.NO_DEPTH_TEST)
+                .withBlend(BlendFunction.TRANSLUCENT)
+                .withCull(false)
+                .build());
+        final RenderLayer q = RenderLayer.of("krypton_esp_quads", RenderSetup.builder(quads).build());
+        final RenderLayer l = RenderLayer.of("krypton_esp_lines", RenderSetup.builder(lines).build());
+        final LinkedHashMap<RenderLayer, BufferAllocator> buffers = new LinkedHashMap<>();
+        buffers.put(q, new BufferAllocator(1 << 23));
+        buffers.put(l, new BufferAllocator(1 << 16));
+        immediate = VertexConsumerProvider.immediate(buffers, new BufferAllocator(1 << 12));
+        lineLayer = l;
+        quadLayer = q;
+    }
+
+    private static void onEndMain(final WorldRenderContext context) {
+        final MinecraftClient mc = Krypton.mc;
+        if (disabled || mc == null || mc.world == null || mc.player == null || Krypton.INSTANCE == null) {
+            return;
+        }
+        try {
+            init();
+            active = true;
+            final float tickDelta = mc.getRenderTickCounter().getTickProgress(true);
+            EventManager.b(new Render3DEvent(new MatrixStack(), new Matrix4f(), tickDelta));
+            active = false;
+            immediate.draw();
+        } catch (final Throwable t) {
+            active = false;
+            disabled = true;
+            System.err.println("[Krypton] Ve 3D (ESP) bi tat do loi:");
+            t.printStackTrace(System.err);
+        }
+    }
+
+    public static void filledBox(final MatrixStack stack, final float x1, final float y1, final float z1, final float x2, final float y2, final float z2, final Color color) {
+        if (!active) {
+            return;
+        }
+        final MatrixStack.Entry e = stack.peek();
+        final VertexConsumer vc = immediate.getBuffer(quadLayer);
+        final int r = color.getRed();
+        final int g = color.getGreen();
+        final int b = color.getBlue();
+        final int a = color.getAlpha();
+        quad(vc, e, r, g, b, a, x1, y1, z1, x2, y1, z1, x2, y1, z2, x1, y1, z2); // dưới
+        quad(vc, e, r, g, b, a, x1, y2, z1, x1, y2, z2, x2, y2, z2, x2, y2, z1); // trên
+        quad(vc, e, r, g, b, a, x1, y1, z1, x1, y2, z1, x2, y2, z1, x2, y1, z1); // bắc
+        quad(vc, e, r, g, b, a, x1, y1, z2, x2, y1, z2, x2, y2, z2, x1, y2, z2); // nam
+        quad(vc, e, r, g, b, a, x1, y1, z1, x1, y1, z2, x1, y2, z2, x1, y2, z1); // tây
+        quad(vc, e, r, g, b, a, x2, y1, z1, x2, y2, z1, x2, y2, z2, x2, y1, z2); // đông
+    }
+
+    private static void quad(final VertexConsumer vc, final MatrixStack.Entry e, final int r, final int g, final int b, final int a,
+                             final float ax, final float ay, final float az, final float bx, final float by, final float bz,
+                             final float cx, final float cy, final float cz, final float dx, final float dy, final float dz) {
+        vc.vertex(e, ax, ay, az).color(r, g, b, a);
+        vc.vertex(e, bx, by, bz).color(r, g, b, a);
+        vc.vertex(e, cx, cy, cz).color(r, g, b, a);
+        vc.vertex(e, dx, dy, dz).color(r, g, b, a);
+    }
+
+    /** Mot mat vuong cua o (x,y,z). dir: 0=duoi 1=tren 2=bac(-z) 3=nam(+z) 4=tay(-x) 5=dong(+x). */
+    public static void faceQuad(final MatrixStack stack, final int x, final int y, final int z, final int dir, final int r, final int g, final int b, final int a) {
+        if (!active) {
+            return;
+        }
+        final MatrixStack.Entry e = stack.peek();
+        final VertexConsumer vc = immediate.getBuffer(quadLayer);
+        final float x1 = x;
+        final float y1 = y;
+        final float z1 = z;
+        final float x2 = x + 1;
+        final float y2 = y + 1;
+        final float z2 = z + 1;
+        switch (dir) {
+            case 0 -> quad(vc, e, r, g, b, a, x1, y1, z1, x2, y1, z1, x2, y1, z2, x1, y1, z2);
+            case 1 -> quad(vc, e, r, g, b, a, x1, y2, z1, x1, y2, z2, x2, y2, z2, x2, y2, z1);
+            case 2 -> quad(vc, e, r, g, b, a, x1, y1, z1, x1, y2, z1, x2, y2, z1, x2, y1, z1);
+            case 3 -> quad(vc, e, r, g, b, a, x1, y1, z2, x2, y1, z2, x2, y2, z2, x1, y2, z2);
+            case 4 -> quad(vc, e, r, g, b, a, x1, y1, z1, x1, y1, z2, x1, y2, z2, x1, y2, z1);
+            default -> quad(vc, e, r, g, b, a, x2, y1, z1, x2, y2, z1, x2, y2, z2, x2, y1, z2);
+        }
+    }
+
+    public static void line(final MatrixStack stack, final Color color, final Vec3d from, final Vec3d to) {
+        line(stack, color, from, to, 2.0f);
+    }
+
+    public static void line(final MatrixStack stack, final Color color, final Vec3d from, final Vec3d to, final float width) {
+        if (!active) {
+            return;
+        }
+        final MatrixStack.Entry e = stack.peek();
+        final VertexConsumer vc = immediate.getBuffer(lineLayer);
+        final Vec3d dir = to.subtract(from);
+        final double len = dir.length();
+        final float nx = len > 1.0E-6 ? (float) (dir.x / len) : 0.0f;
+        final float ny = len > 1.0E-6 ? (float) (dir.y / len) : 1.0f;
+        final float nz = len > 1.0E-6 ? (float) (dir.z / len) : 0.0f;
+        final int r = color.getRed();
+        final int g = color.getGreen();
+        final int b = color.getBlue();
+        final int a = color.getAlpha();
+        vc.vertex(e, (float) from.x, (float) from.y, (float) from.z).color(r, g, b, a).normal(e, nx, ny, nz).lineWidth(width);
+        vc.vertex(e, (float) to.x, (float) to.y, (float) to.z).color(r, g, b, a).normal(e, nx, ny, nz).lineWidth(width);
+    }
+}
