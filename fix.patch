+            PickerUi.rounded(ctx, new Color(this.withChannel(rgb, i, 255) | 0xFF000000), SLIDER_X, top, SLIDER_X + SLIDER_W, bottom, SLIDER_H / 2.0);
+            PickerUi.rounded(ctx, new Color(this.withChannel(rgb, i, 0) | 0xFF000000), SLIDER_X, top, SLIDER_X + SLIDER_H, bottom, SLIDER_H / 2.0);
+            for (int x = SLIDER_H / 2; x < SLIDER_W - SLIDER_H / 2; x += 3) {
+                final int c = Math.round(clamp01((x + 1.5 - SLIDER_H / 2.0) / (SLIDER_W - SLIDER_H)) * 255.0f);
+                ctx.fill(SLIDER_X + x, top, SLIDER_X + Math.min(x + 3, SLIDER_W - SLIDER_H / 2), bottom, this.withChannel(rgb, i, c) | 0xFF000000);
+            }
+            final double hx = SLIDER_X + SLIDER_H / 2.0 + values[i] / 255.0 * (SLIDER_W - SLIDER_H);
+            PickerUi.circle(ctx, Color.WHITE, hx, cy, 14);
+            PickerUi.circle(ctx, new Color(rgb | 0xFF000000), hx, cy, 11);
