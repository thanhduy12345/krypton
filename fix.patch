+    private static final int AREA_H = 205;
+    private static final int HUE_Y = 330;
+    private static final int HUE_H = 30;
+    private static final int ALPHA_Y = 396;
+    private static final int ALPHA_W = 312;
+    private static final int ALPHA_H = 26;
+    private static final int GRID_COLS = 12;
+    private static final int GRID_ROWS = 7;
+    private static final int SLIDER_X = AREA_X;
+    private static final int SLIDER_W = AREA_W;
+    private static final int SLIDER_H = 26;
+    private static final int HEX_Y = 312;
+    private static final int HEX_H = 34;
+    private static final int HEX_FIELD_X = 236;
+    private static final int HEX_FIELD_W = 160;
+
+    private static final int DRAG_NONE = 0;
+    private static final int DRAG_AREA = 1;
+    private static final int DRAG_HUE = 2;
+    private static final int DRAG_ALPHA = 3;
+    private static final int DRAG_RED = 4;
+
+    private final Screen parent;
+    private final BlockColorSetting setting;
+    private final Block block;
+    private final String title;
+    private final int originalArgb;
+    private float hue;
+    private float sat;
+    private float val;
+    private int alpha;
+    private int tab = 1;
+    private int rgb;
+    private boolean hexFocused;
+    private boolean hexFresh;
+    private String hexText = "";
+    private double tabAnim = -1.0;
+    private long lastNanos;
+    private double ease = 1.0;
+    private int dragging = DRAG_NONE;
+    private float scale = 1.0f;
+    private int originX;
+    private int originY;
+
+    public ColorPicker(final Screen parent, final BlockColorSetting setting, final Block block, final String title) {
+        super(Text.empty());
+        this.parent = parent;
+        this.setting = setting;
+        this.block = block;
+        this.title = title == null ? "COLOR" : title;
+        this.originalArgb = setting.getColor(block);
+        this.alpha = this.originalArgb >>> 24;
+        this.setRgb(this.originalArgb & 0xFFFFFF);
+    }
+
+    // ------------------------------------------------------------------ colour state
+    private void setRgb(final int rgb) {
+        this.rgb = rgb & 0xFFFFFF;
+        final float[] hsb = Color.RGBtoHSB((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, null);
+        // keep the old hue for greys, otherwise the hue bar would jump to red
+        if (hsb[1] > 0.0f && hsb[2] > 0.0f) {
+            this.hue = hsb[0];
+        }
+        this.sat = hsb[1];
+        this.val = hsb[2];
+    }
+
+    private int currentRgb() {
+        return this.rgb;
+    }
+
+    /** Called after the hue / saturation / brightness changed (spectrum drag) to refresh the exact RGB value. */
+    private void syncRgb() {
+        this.rgb = Color.HSBtoRGB(this.hue, this.sat, this.val) & 0xFFFFFF;
+    }
+
+    private int sliderCy(final int i) {
+        return AREA_Y + 44 + i * 62;
+    }
+
+    // ------------------------------------------------------------------ hex input
+    private static boolean validHex(final String t) {
+        final int n = t.length();
+        if (n != 3 && n != 6 && n != 8) {
+            return false;
+        }
+        for (int i = 0; i < n; ++i) {
+            if (Character.digit(t.charAt(i), 16) < 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private void applyHex(final String t) {
+        if (!validHex(t)) {
+            return;
+        }
+        String full = t;
+        if (t.length() == 3) {
+            final StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < 3; ++i) {
+                sb.append(t.charAt(i)).append(t.charAt(i));
+            }
+            full = sb.toString();
+        }
+        this.setRgb(Integer.parseInt(full.substring(0, 6), 16));
+        if (full.length() == 8) {
+            this.alpha = Integer.parseInt(full.substring(6, 8), 16);
+        }
+    }
+
+    private void commitHex() {
+        if (validHex(this.hexText)) {
+            this.applyHex(this.hexText);
+        }
+        this.hexFocused = false;
+        this.hexFresh = false;
+    }
+
+    private void typeHex(final String chars) {
+        final StringBuilder sb = new StringBuilder(this.hexFresh ? "" : this.hexText);
+        this.hexFresh = false;
+        for (int i = 0; i < chars.length(); ++i) {
+            final char c = chars.charAt(i);
+            if (Character.digit(c, 16) >= 0 && sb.length() < 8) {
+                sb.append(Character.toUpperCase(c));
+            }
+        }
+        this.hexText = sb.toString();
+        if (validHex(this.hexText)) {
+            this.applyHex(this.hexText);
+        }
+    }
+
+    private int currentArgb() {
+        return (this.alpha << 24) | this.currentRgb();
+    }
+
+    private static float clamp01(final double v) {
+        return (float) Math.max(0.0, Math.min(1.0, v));
+    }
+
+    // ------------------------------------------------------------------ layout
+    private void layout() {
+        final int ww = MinecraftClient.getInstance().getWindow().getWidth();
+        final int wh = MinecraftClient.getInstance().getWindow().getHeight();
+        this.scale = Math.max(0.3f, Math.min(1.0f, Math.min((ww - 40) / (float) W, (wh - 40) / (float) H)));
+        this.originX = (int) ((ww - W * this.scale) / 2.0f);
+        this.originY = (int) ((wh - H * this.scale) / 2.0f);
+    }
+
+    private double toDesignX(final double px) {
+        return (px - this.originX) / this.scale;
+    }
+
+    private double toDesignY(final double py) {
+        return (py - this.originY) / this.scale;
+    }
+
+    private void apply() {
+        this.setting.setColor(this.block, this.currentArgb());
+        MinecraftClient.getInstance().setScreen(this.parent);
+    }
+
+    private void back() {
+        MinecraftClient.getInstance().setScreen(this.parent);
+    }
+
+    // ------------------------------------------------------------------ rendering
+    @Override
+    public void render(final DrawContext ctx, final int mx, final int my, final float delta) {
+        RenderUtils.currentContext = ctx;
+        RenderUtils.unscaledProjection();
+        final long now = System.nanoTime();
+        final double dt = this.lastNanos == 0L ? 0.016 : Math.min(0.1, (now - this.lastNanos) / 1.0e9);
+        this.lastNanos = now;
+        this.ease = 1.0 - Math.exp(-dt * 20.0);
+        final MinecraftClient mc = MinecraftClient.getInstance();
+        final double sf = mc.getWindow().getScaleFactor();
+        super.render(ctx, (int) (mx * sf), (int) (my * sf), delta);
+        this.layout();
+        ctx.fill(0, 0, mc.getWindow().getWidth(), mc.getWindow().getHeight(), new Color(0, 0, 0, Krypton.renderBackground.getValue() ? 180 : 0).getRGB());
+        final Matrix3x2fStack m = ctx.getMatrices();
+        m.pushMatrix();
+        m.translate((float) this.originX, (float) this.originY);
+        m.scale(this.scale, this.scale);
+        this.drawPanel(ctx);
+        m.popMatrix();
+        RenderUtils.scaledProjection();
+    }
+
+    private void drawPanel(final DrawContext ctx) {
+        PickerUi.rounded(ctx, PickerUi.PANEL, 0, 0, W, H, 18);
+
+        // header
+        PickerUi.text(ctx, "CANCEL", 24, 20, PickerUi.ACCENT.getRGB(), 0.8f);
+        PickerUi.centered(ctx, this.title, W / 2.0, 19, Color.WHITE.getRGB(), 0.9f);
+        PickerUi.text(ctx, "DONE", W - 24 - PickerUi.width("DONE", 0.8f), 20, PickerUi.ACCENT.getRGB(), 0.8f);
+
+        // tabs
+        PickerUi.rounded(ctx, PickerUi.FIELD, 24, 66, 396, 98, 10);
+        final double tabTarget = 24 + this.tab * 124;
+        this.tabAnim = this.tabAnim < 0.0 ? tabTarget : this.tabAnim + (tabTarget - this.tabAnim) * this.ease;
+        final double tabX = this.tabAnim;
+        PickerUi.rounded(ctx, new Color(92, 94, 102, 255), tabX + 3, 69, tabX + 121, 95, 8);
+        PickerUi.centered(ctx, "GRID", 24 + 62, 74, PickerUi.TEXT.getRGB(), 0.7f);
+        PickerUi.centered(ctx, "SPECTRUM", 24 + 124 + 62, 74, PickerUi.TEXT.getRGB(), 0.7f);
+        PickerUi.centered(ctx, "SLIDERS", 24 + 248 + 62, 74, PickerUi.TEXT.getRGB(), 0.7f);
+
+        if (this.tab == 0) {
+            this.drawGrid(ctx);
+        } else if (this.tab == 1) {
+            this.drawSpectrum(ctx);
+            this.drawHueBar(ctx);
+        } else {
+            this.drawSliders(ctx);
+        }
+        this.drawAlpha(ctx);
+        this.drawPreview(ctx);
+    }
+
+    private void drawSpectrum(final DrawContext ctx) {
+        final int step = 4;
+        for (int cx = 0; cx < AREA_W; cx += step) {
+            final float s = clamp01((cx + step / 2.0) / AREA_W);
+            final int w = Math.min(step, AREA_W - cx);
+            for (int cy = 0; cy < AREA_H; cy += step) {
+                final float v = 1.0f - clamp01((cy + step / 2.0) / AREA_H);
+                final int h = Math.min(step, AREA_H - cy);
+                ctx.fill(AREA_X + cx, AREA_Y + cy, AREA_X + cx + w, AREA_Y + cy + h, Color.HSBtoRGB(this.hue, s, v) | 0xFF000000);
+            }
+        }
+        final double hx = AREA_X + this.sat * AREA_W;
+        final double hy = AREA_Y + (1.0f - this.val) * AREA_H;
+        PickerUi.circle(ctx, Color.WHITE, hx, hy, 10);
+        PickerUi.circle(ctx, new Color(this.currentRgb() | 0xFF000000), hx, hy, 8);
+    }
+
+    private void drawHueBar(final DrawContext ctx) {
+        PickerUi.rounded(ctx, new Color(255, 0, 0), AREA_X, HUE_Y, AREA_X + AREA_W, HUE_Y + HUE_H, 15);
+        for (int x = 14; x < AREA_W - 14; x += 3) {
+            final float h = clamp01((x + 1.5) / AREA_W);
+            ctx.fill(AREA_X + x, HUE_Y, AREA_X + Math.min(x + 3, AREA_W - 14), HUE_Y + HUE_H, Color.HSBtoRGB(h, 1.0f, 1.0f) | 0xFF000000);
+        }
+        final double hx = Math.max(AREA_X + 15, Math.min(AREA_X + AREA_W - 15, AREA_X + this.hue * AREA_W));
+        PickerUi.circle(ctx, Color.WHITE, hx, HUE_Y + HUE_H / 2.0, 15);
+        PickerUi.circle(ctx, new Color(Color.HSBtoRGB(this.hue, 1.0f, 1.0f) | 0xFF000000), hx, HUE_Y + HUE_H / 2.0, 12);
+    }
+
+    private void drawAlpha(final DrawContext ctx) {
+        PickerUi.text(ctx, "OPACITY", 24, ALPHA_Y - 22, PickerUi.MUTED.getRGB(), 0.55f);
+        PickerUi.rounded(ctx, new Color(235, 235, 235), AREA_X, ALPHA_Y, AREA_X + ALPHA_W, ALPHA_Y + ALPHA_H, 13);
+        for (int x = 13; x < ALPHA_W - 13; x += 8) {
+            for (int y = 0; y < ALPHA_H; y += 8) {
+                if (((x / 8) + (y / 8)) % 2 == 0) {
+                    ctx.fill(AREA_X + x, ALPHA_Y + y, AREA_X + Math.min(x + 8, ALPHA_W - 13), ALPHA_Y + Math.min(y + 8, ALPHA_H), new Color(190, 190, 190).getRGB());
+                }
+            }
+        }
+        final int rgb = this.currentRgb();
+        for (int x = 13; x < ALPHA_W - 13; x += 3) {
+            final int a = Math.round(clamp01((x + 1.5) / ALPHA_W) * 255.0f);
+            ctx.fill(AREA_X + x, ALPHA_Y, AREA_X + Math.min(x + 3, ALPHA_W - 13), ALPHA_Y + ALPHA_H, (a << 24) | rgb);
+        }
+        PickerUi.rounded(ctx, new Color((this.alpha << 24) | rgb, true), AREA_X, ALPHA_Y, AREA_X + 13, ALPHA_Y + ALPHA_H, 13);
+        final double hx = Math.max(AREA_X + 14, Math.min(AREA_X + ALPHA_W - 14, AREA_X + this.alpha / 255.0 * ALPHA_W));
+        PickerUi.circle(ctx, Color.WHITE, hx, ALPHA_Y + ALPHA_H / 2.0, 14);
+        PickerUi.circle(ctx, new Color(rgb | 0xFF000000), hx, ALPHA_Y + ALPHA_H / 2.0, 11);
+        final String percent = Math.round(this.alpha * 100.0f / 255.0f) + "%";
+        PickerUi.text(ctx, percent, AREA_X + AREA_W - PickerUi.width(percent, 0.75f), ALPHA_Y + 4, PickerUi.TEXT.getRGB(), 0.75f);
+    }
+
+    private void drawPreview(final DrawContext ctx) {
+        final int y1 = 445;
+        final int y2 = 500;
+        final Color original = new Color(this.originalArgb, true);
+        final Color current = new Color(this.currentArgb(), true);
+        PickerUi.rounded(ctx, current, AREA_X, y1, AREA_X + AREA_W, y2, 12);
+        PickerUi.rounded(ctx, original, AREA_X, y1, AREA_X + 36, y2, 12);
+        ctx.fill(AREA_X + 12, y1, AREA_X + AREA_W / 2, y2, original.getRGB());
+        PickerUi.text(ctx, "ORIGINAL", AREA_X + 14, y2 - 24, contrast(this.originalArgb), 0.6f);
+        PickerUi.text(ctx, "NEW", AREA_X + AREA_W / 2 + 14, y2 - 24, contrast(this.currentArgb()), 0.6f);
+    }
+
+    private static int contrast(final int argb) {
+        final double luma = 0.299 * ((argb >> 16) & 255) + 0.587 * ((argb >> 8) & 255) + 0.114 * (argb & 255);
+        return luma > 150 ? new Color(20, 20, 24).getRGB() : Color.WHITE.getRGB();
+    }
+
+    // ---- grid tab
+    private int paletteColor(final int col, final int row) {
+        if (row == 0) {
+            final int g = Math.round(255.0f * (1.0f - col / (float) (GRID_COLS - 1)));
+            return (g << 16) | (g << 8) | g;
+        }
+        final float h = col / (float) GRID_COLS;
+        final float[][] variants = {{0.35f, 1.0f}, {0.65f, 1.0f}, {1.0f, 1.0f}, {1.0f, 0.75f}, {1.0f, 0.5f}, {1.0f, 0.3f}};
+        final float[] sv = variants[row - 1];
+        return Color.HSBtoRGB(h, sv[0], sv[1]) & 0xFFFFFF;
+    }
+
+    private void drawGrid(final DrawContext ctx) {
+        final int cw = AREA_W / GRID_COLS;
+        final int ch = AREA_H / GRID_ROWS;
+        for (int row = 0; row < GRID_ROWS; ++row) {
+            for (int col = 0; col < GRID_COLS; ++col) {
+                final int rgb = this.paletteColor(col, row);
+                final int x = AREA_X + col * cw;
+                final int y = AREA_Y + row * ch;
+                PickerUi.rounded(ctx, new Color(rgb | 0xFF000000), x + 1, y + 1, x + cw - 1, y + ch - 1, 4);
+                if (rgb == this.currentRgb()) {
+                    PickerUi.outline(ctx, Color.WHITE, x, y, x + cw, y + ch, 4, 2.0);
+                }
+            }
+        }
+    }
+
+    // ---- sliders tab
+    private void drawSliders(final DrawContext ctx) {
+        final String[] names = {"RED", "GREEN", "BLUE"};
+        final int rgb = this.currentRgb();
+        final int[] values = {(rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255};
+        for (int i = 0; i < 3; ++i) {
+            final int cy = this.sliderCy(i);
+            final int top = cy - SLIDER_H / 2;
+            final int bottom = cy + SLIDER_H / 2;
+            PickerUi.text(ctx, names[i], SLIDER_X + 4, cy - 34, PickerUi.MUTED.getRGB(), 0.55f);
+            final String v = String.valueOf(values[i]);
